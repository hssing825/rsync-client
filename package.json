{
  "name": "rsync-client",
  "version": "1.0.0",
  "description": "Rsync backup client with web interface",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker:build": "docker build -t rsync-client .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lowdb": "^1.0.0",
    "node-cron": "^3.0.3",
    "webdav-server": "^2.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}